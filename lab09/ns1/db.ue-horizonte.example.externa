; /var/lib/bind/externa/db.ue-horizonte.example — Lo que ve INTERNET (IPs públicas; se FIRMA con DNSSEC)
; Contenido equivalente al generado por DNSControl en el Laboratorio 8.
$ORIGIN ue-horizonte.example.
$TTL 3600
@   IN SOA ns1.ue-horizonte.example. ti.ue-horizonte.example. ( 2026101401 3600 600 1209600 300 )
@       IN NS  ns1
@       IN NS  ns2
ns1     IN A   172.30.0.2            ; en el laboratorio, la "cara pública" de ns1
ns2     IN A   198.51.100.3
@       IN A   203.0.113.20
www     IN A   203.0.113.20
portal  IN CNAME www
mail    IN A   203.0.113.25
@       IN MX  10 mail
@       IN TXT "v=spf1 mx -all"
_dmarc  IN TXT "v=DMARC1; p=quarantine; rua=mailto:dmarc@ue-horizonte.example"
@       IN CAA 0 issue "letsencrypt.org"
@       IN CAA 0 issuewild ";"
